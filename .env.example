# Firebase Authentication Configuration
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Security: Administrator Authentication
# Authorized administrator accounts are managed directly in the Firebase Console (Authentication > Users).
# Any user account registered/enabled in Firebase will be granted access upon successful sign-in.

# GitHub Publishing Configuration (Cloudflare Pages Environment Secret)
# Personal Access Token (PAT) with 'repo' scope to publish siteContent.json commits server-side via /api/github
# In Cloudflare Pages: Settings > Environment variables > Add Variable > Encrypted secret:
GITHUB_TOKEN=your_github_personal_access_token_here
